// Configuration Cloudflare de Le Fil.
//   npx wrangler deploy --env test   -> version de test (le-fil-test.<sous-domaine>.workers.dev), relève au repos
//   npx wrangler deploy --env test --var RELEVE:oui   -> version de test avec sa propre relève (penser à la remettre au repos)
//   npx wrangler deploy              -> le vrai site (le-fil.<sous-domaine>.workers.dev)
// Les secrets SYNC_KEY et NTFY_TOPIC se règlent à part (npx wrangler secret put SYNC_KEY) : jamais ici.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "le-fil",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "preview_urls": false,
  // Les fichiers de public/ (page, service worker, icônes, modèle Anki) sont intégrés au Worker à la mise en ligne.
  "rules": [
    { "type": "Text", "globs": ["**/public/sw.js", "**/*.webmanifest", "**/*.html"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.png", "**/*.apkg"], "fallthrough": true }
  ],
  "d1_databases": [{ "binding": "DB", "database_name": "le-fil", "database_id": "4a563326-ad2f-44f3-90f8-416f6c03ce1b" }],
  // Releveur : relève les flux en continu (Durable Object à base SQLite, inclus dans l'offre gratuite)
  "durable_objects": { "bindings": [{ "name": "RELEVEUR", "class_name": "Releveur" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Releveur"] }],
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "env": {
    "test": {
      "d1_databases": [{ "binding": "DB", "database_name": "le-fil", "database_id": "4a563326-ad2f-44f3-90f8-416f6c03ce1b" }],
      "durable_objects": { "bindings": [{ "name": "RELEVEUR", "class_name": "Releveur" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Releveur"] }],
      // Au repos par défaut : la version de test ne relève rien tant qu'on ne met pas RELEVE à "oui"
      "vars": { "RELEVE": "non" },
      "triggers": { "crons": [] },
      "observability": { "enabled": true, "head_sampling_rate": 1 }
    }
  }
}
